{
  "dependencies": {
    "commander": "^14.0.2",
    "cors": "^2.8.5",
    "dotenv": "^17.3.1",
    "express": "^5.2.1",
    "jsonld": "^9.0.0",
    "marked": "^17.0.1",
    "morgan": "^1.10.1",
    "rdf-ext": "^2.6.0",
    "rdf-parse": "^4.0.0",
    "rdf-serialize": "^5.1.0",
    "shacl-engine": "^1.1.0",
    "stream-to-string": "^1.2.1",
    "streamify-array": "^2.0.0",
    "streamify-string": "^1.0.1",
    "winston": "^3.19.0"
  },
  "type": "module",
  "name": "shacl-validator",
  "version": "1.0.0",
  "description": "A command line shacl validator",
  "main": "lib/index.js",
  "directories": {
    "example": "examples"
  },
  "bin": {
    "shacl-validator": "./bin/index.js"
  },
  "scripts": {
    "server": "node ./bin/index.js server",
    "docker:build": "docker build . -t hochstenbach/shacl-validator:v0.0.1",
    "docker:run": "docker run --env-file .env -p 3000:3000 -v shapes:/app/shapes hochstenbach/shacl-validator:v0.0.1"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MellonScholarlyCommunication/shacl-validator.git"
  },
  "keywords": [
    "shacl",
    "rdf",
    "validator"
  ],
