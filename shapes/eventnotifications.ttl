@prefix evt: <https://www.eventnotifications.net/ns/shapes#> .
@prefix as: <https://www.w3.org/ns/activitystreams#> .
@prefix ldp: <http://www.w3.org/ns/ldp#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

evt:MainShape
    a sh:NodeShape ;
    sh:closed false ;
    sh:targetNode "%MainSubject%" ;
    sh:nodeKind sh:IRI ;
    sh:message "a *notification*, with a value that does not have a valid *URL* or *URN*" .

evt:MainShapeType 
    a sh:NodeShape ;
    sh:closed false ;
    sh:targetNode "%MainSubject%" ;
    sh:or (
        [ sh:class as:Create   ]
        [ sh:class as:Update   ]
        [ sh:class as:Remove   ]
        [ sh:class as:Offer    ]
        [ sh:class as:Announce ]
        [ sh:class as:Accept   ]
        [ sh:class as:Reject   ]
        [ sh:class as:Undo     ]
    ) ;
    sh:message "description without an activity type (create,update,remove,offer,announce,accept,reject,undo)" .

evt:SimpleShape
    a sh:NodeShape ;
    sh:closed false ;
    sh:targetClass as:Create , as:Update, as:Remove , as:Offer ;
    sh:property [
        sh:path as:actor ;
        sh:nodeKind sh:IRI ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node evt:AgentShape ;
        sh:message "value does not look like an URI" ;
    ] ;
	sh:property [
      	sh:path as:object ;
        sh:nodeKind sh:IRI ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
    ] ;
    sh:property [
        sh:path as:origin ;
        sh:nodeKind sh:IRI ;
        sh:minCount 0 ;
        sh:maxCount 1 ;
        sh:node evt:AgentShape ;
    ] ;
    sh:property [
        sh:path as:target ;
        sh:nodeKind sh:IRI ;
        sh:minCount 0 ;
        sh:maxCount 1 ;
        sh:node evt:AgentShape ;
    ] .

evt:ReplyShape
    a sh:NodeShape ;
    sh:closed false;
    sh:targetClass 
		as:Announce , as:Accept , as:Reject , as:Undo ;
    sh:property [
        sh:path as:actor ;
        sh:nodeKind sh:IRI ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node evt:AgentShape ;
    ] ;
	sh:property [
      	sh:path as:object ;
        sh:nodeKind sh:IRI ;
        sh:minCount 1 ;
    ] ;
    sh:property [
        sh:path as:origin ;
        sh:nodeKind sh:IRI ;
        sh:minCount 0 ;
        sh:maxCount 1 ;
        sh:node evt:AgentShape ;
    ] ;
    sh:property [
        sh:path as:target ;
        sh:nodeKind sh:IRI ;
        sh:minCount 0 ;
        sh:maxCount 1 ;
        sh:node evt:AgentShape ;
    ] ;
	sh:property [
      	sh:path as:context ;
        sh:maxCount 1 ;
    ] ;
	sh:property [
      	sh:path as:inReplyTo ;
        sh:maxCount 1 ;
    ] .

evt:AgentShape
    a sh:NodeShape ;
    sh:closed false ;
    sh:property [
        sh:path ldp:inbox ;
        sh:minCount 0;
        sh:maxCount 1;
        sh:nodeKind sh:IRIOrLiteral ;
    ] .

# Warn about resources that (transitively) point back to themselves
evt:CycleShape
    a sh:NodeShape ;
    sh:targetSubjectsOf rdf:type ;
    sh:severity sh:Warning ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "a reference that loops back to {$this} via {?path}" ;
        sh:select """
            PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
            PREFIX ietf: <http://www.iana.org/assignments/relation/>
            SELECT $this ?path ?value
            WHERE {
                $this ?path ?value .
                FILTER(isIRI(?value) || isBlank(?value))
                FILTER(?path NOT IN (rdf:type, ietf:cite-as))
                ?value (!(rdf:type|ietf:cite-as))* $this .
            }
        """
    ] .
