{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "errorMessage": "preferred input is a JSON-LD compact form, not an array",
  "propertyNames": {
    "pattern": "^(@context|[a-zA-Z-]+(:[a-zA-Z-]+)?)$",
    "errorMessage": "property should match a simple name or namespace:name"
  },
  "properties": {
    "@context": {
        "type": "array",
        "items": { "type": "string" }
    },
    "@graph": {
      "not": {},
      "errorMessage": " The '@graph' construct in your JSON-LD is not preferred. Please use a simpler, more compact form"
    },
    "@id": { 
      "not": {},
      "errorMessage": "the '@id' property is not preferred, use 'id'"
    },
    "id": { "type": "string" },
    "summary": { "type": "string" },
    "@type": { 
      "not": {},
      "errorMessage": "the '@type' property is not preferred, use 'type'"
    },
    "type": {
        "oneOf": [
            { "type": "string" },
            { 
            "type": "array",
            "items": { "type": "string" }
            }
        ]
    },
    "actor": {
      "type": "object",
      "properties": {
        "@id": { 
          "not": {},
          "errorMessage": "the '@id' property is not preferred, use 'id'"
        },
        "id": { "type": "string" },
        "@type": { 
          "not": {},
          "errorMessage": "the '@type' property is not preferred, use 'type'"
        },
        "type": { "type": "string" },
        "name": { "type": "string" } 
      },
      "required": [ "id", "type" ],
      "additionalProperties": true
    },
    "origin": {
      "type": "object",
      "properties": {
        "@id": { 
          "not": {},
          "errorMessage": "the '@id' property is not preferred, use 'id'"
        },
        "id": { "type": "string" },
        "@type": { 
          "not": {},
          "errorMessage": "the '@type' property is not preferred, use 'type'"
        },
        "type": { "type": "string" },
        "name": { "type": "string" } 
      },
      "required": [ "id", "type" ],
      "additionalProperties": true
    },
    "object": { "$ref": "#" },
    "target": {
      "type": "object",
      "properties": {
        "@id": { 
          "not": {},
          "errorMessage": "the '@id' property is not preferred, use 'id'"
        },
        "id": { "type": "string" },
        "@type": { 
          "not": {},
          "errorMessage": "the '@type' property is not preferred, use 'type'"
        },
        "type": { "type": "string" },
        "name": { "type": "string" } 
      },
      "required": [ "id", "type" ],
      "additionalProperties": true
    },
    "inReplyTo": { "type": "string" }
  },
  "required": [ "id" ],
  "additionalProperties": true
}