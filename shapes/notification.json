{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "@context": {
        "type": "array",
        "items": { "type": "string" }
    },
    "id": { "type": "string" },
    "summary": { "type": "string" },
    "type": {
        "oneOf": [
            { "type": "string" },
            { 
            "type": "array",
            "items": { "type": "string" }
            }
        ]
    },
    "actor": {
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "type": { "type": "string" },
        "name": { "type": "string" } 
      },
      "required": [ "id", "type" ],
      "additionalProperties": true
    },
    "origin": {
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "type": { "type": "string" },
        "name": { "type": "string" } 
      },
      "required": [ "id", "type" ],
      "additionalProperties": true
    },
    "object": { "$ref": "#" },
    "target": {
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "type": { "type": "string" },
        "name": { "type": "string" } 
      },
      "required": [ "id", "type" ],
      "additionalProperties": true
    },
    "inReplyTo": { "type": "string" }
  },
  "required": [ "id" ],
  "additionalProperties": true
}