@prefix notify: <http://coar-notify.net/specification/vocabulary/> .
@prefix ietf: <http://www.iana.org/assignments/relation/> .
@prefix sorg: <http://schema.org/> .
@prefix as: <https://www.w3.org/ns/activitystreams#> .
@prefix ldp: <http://www.w3.org/ns/ldp#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix this: <https://github.com/MellonScholarlyCommunication/shacl-validator/> .

# Main shape the mother of all subjects
notify:MainShape
    a sh:NodeShape ;
    sh:closed false ;
    sh:targetNode "%MainSubject%" ;
    sh:nodeKind sh:IRI ;
    sh:message "A *notification*, with a value that does not have a valid *URL* or *URN*" .

# All supported shapes
notify:MainShapeType 
    a sh:NodeShape ;
    sh:closed false ;
    sh:targetNode "%MainSubject%" ;
    sh:or (
        [ sh:class as:Accept   ]
        [ sh:class as:Announce ]
        [ sh:class as:Flag     ]
        [ sh:class as:Offer    ]
        [ sh:class as:Reject   ]
        [ sh:class as:TentativeAccept ]
        [ sh:class as:TentativeReject ]
        [ sh:class as:Undo     ]
    ) ;
    sh:message "Description without an activity type (accept, announce, flag, offer, reject, tentativeaccept, tentativereject, undo)" .

# We define RequestShape as having the main ingredients of every Notify
# message: actor, object, origin, target
notify:RequestShape
    a sh:NodeShape ;
    sh:closed false ;
    sh:targetClass as:Offer ;
    sh:or (
        [ sh:class notify:EndorsementAction ]
        [ sh:class notify:ReviewAction ]
    ) ;
    sh:property [
        sh:path as:actor ;
        sh:nodeKind sh:IRI ;
        sh:minCount 0 ; # An actor is recommended
        sh:maxCount 1 ;
        sh:node notify:ActivityStreamsGroupTypes ;
        sh:node notify:ActorShape ;
        sh:message "value does not look like an URI"
    ] ;
	sh:property [
      	sh:path as:object ;
        sh:nodeKind sh:IRI ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node notify:ActivityStreamsTypes ;
        sh:node notify:ArtifactShape
    ] ;
    sh:property [
        sh:path as:origin ;
        sh:nodeKind sh:IRI ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node notify:OriginShape
    ] ;
    sh:property [
        sh:path as:target ;
        sh:nodeKind sh:IRI ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node notify:TargetShape
    ] ;
    sh:message "an Offer notification without a EndorsementAction or ReviewAction" .

# We define ResponseShape as having the main ingredients of every Notify
# message: plus inReplyTo and an object that has a RequestShape
notify:ResponseShape
    a sh:NodeShape ;
    sh:closed false ;
    sh:targetClass 
		as:Accept , as:Reject , as:TentativeAccept, as:TentativeReject, as:Undo ;
    sh:property [
        sh:path as:actor ;
        sh:nodeKind sh:IRI ;
        sh:minCount 0 ; # An actor is recommended
        sh:maxCount 1 ;
        sh:node notify:ActivityStreamsGroupTypes ;
        sh:node notify:ActorShape ;
        sh:message "value does not look like an URI"
    ] ;
	sh:property [
      	sh:path as:object ;
        sh:nodeKind sh:IRI ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
    ] ;
    sh:property [
        sh:path as:origin ;
        sh:nodeKind sh:IRI ;
        sh:minCount 0 ;
        sh:maxCount 1 ;
        sh:node notify:OriginShape
    ] ;
    sh:property [
        sh:path as:target ;
        sh:nodeKind sh:IRI ;
        sh:minCount 0 ;
        sh:maxCount 1 ;
        sh:node notify:TargetShape
    ] ;
    sh:property [
      	sh:path as:inReplyTo ;
        sh:nodeKind sh:IRI ;
        sh:minCount 1 ;
        sh:maxCount 1 
    ] ; 
	sh:property [
      	sh:path as:summary ;
        sh:nodeKind sh:Literal ;
        sh:minCount 0 ;
        sh:maxCount 1 
    ] .

# We define FlagShape as having the a limited form of the ResponseType properties
notify:FlagShape
    a sh:NodeShape ;
    sh:closed false ;
    sh:targetClass as:Flag ;
    sh:or (
        [ sh:class notify:UnprocessableNotification ]
    ) ;
    sh:property [
        sh:path as:actor ;
        sh:nodeKind sh:IRI ;
        sh:minCount 0 ; # An actor is recommended
        sh:maxCount 1 ;
        sh:node notify:ActivityStreamsGroupTypes ;
        sh:node notify:ActorShape ;
        sh:message "value does not look like an URI"
    ] ;
	sh:property [
      	sh:path as:object ;
        sh:nodeKind sh:IRI ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
    ] ;
    sh:property [
        sh:path as:origin ;
        sh:nodeKind sh:IRI ;
        sh:minCount 0 ;
        sh:maxCount 1 ;
        sh:node notify:OriginShape
    ] ;
    sh:property [
        sh:path as:target ;
        sh:nodeKind sh:IRI ;
        sh:minCount 0 ;
        sh:maxCount 1 ;
        sh:node notify:TargetShape
    ] ;
    sh:property [
      	sh:path as:inReplyTo ;
        sh:nodeKind sh:IRI ;
        sh:minCount 1 ;
        sh:maxCount 1 
    ] ; 
	sh:property [
      	sh:path as:summary ;
        sh:nodeKind sh:Literal ;
        sh:minCount 0 ;
        sh:maxCount 1 
    ] ;
    sh:message "a Flag notification without a coar-notify UnprocessableNotification" .

# Announce Shapes. We split them up to have better control over the different
# types of validation.
notify:AnnounceEndorsementShape
    a sh:NodeShape ;
    sh:closed false ;
    sh:target [
        a sh:SPARQLTarget ;
	    sh:select """
            PREFIX notify: <http://coar-notify.net/specification/vocabulary/> 
            PREFIX as: <https://www.w3.org/ns/activitystreams#> 
			SELECT ?this
			WHERE {
                ?this a as:Announce .
				?this a notify:EndoresementAction .
			}
		"""
	] ;
    sh:property [
        sh:path as:actor ;
        sh:nodeKind sh:IRI ;
        sh:minCount 0 ; # An actor is recommended
        sh:maxCount 1 ;
        sh:node notify:ActivityStreamsGroupTypes ;
        sh:node notify:ActorShape ;
        sh:message "value does not look like an URI"
    ] ;
	sh:property [
      	sh:path as:object ;
        sh:nodeKind sh:IRI ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node notify:ActivityStreamsTypes ;
        sh:node notify:ServiceResultShape
    ] ;
    sh:property [
        sh:path as:origin ;
        sh:nodeKind sh:IRI ;
        sh:minCount 0 ;
        sh:maxCount 1 ;
        sh:node notify:OriginShape
    ] ;
    sh:property [
        sh:path as:target ;
        sh:nodeKind sh:IRI ;
        sh:minCount 0 ;
        sh:maxCount 1 ;
        sh:node notify:TargetShape
    ] ;
    sh:property [
      	sh:path as:inReplyTo ;
        sh:nodeKind sh:IRI ;
        sh:minCount 0 ;
        sh:maxCount 1 
    ] ; 
    sh:property [
        sh:path as:context ;
        sh:or (
            [ sh:nodeKind sh:IRI ]

            [ 
                sh:node notify:ActivityStreamsTypes ;
                sh:node notify:ContextShape 
            ]
        ) ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node notify:ContextShape 
    ].

