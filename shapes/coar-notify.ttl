notify:GenericAnnounceShape
    a sh:NodeShape ;
    sh:closed false ;
    sh:target [
        a sh:SPARQLTarget ;
	    sh:select """
            PREFIX notify: <http://coar-notify.net/specification/vocabulary/> 
            PREFIX as: <https://www.w3.org/ns/activitystreams#> 
			SELECT ?this
			WHERE {
                ?this a as:Announce .
				?this a notify:GenericAction .
			}
		"""
	] ;
    sh:property [
        sh:path as:actor ;
        sh:nodeKind sh:IRI ;
        sh:minCount 0 ; # An actor is recommended
        sh:maxCount 1 ;
