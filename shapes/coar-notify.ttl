## End Announce shapes

## Helper shapes ##################################################

notify:ActorShape
    a sh:NodeShape ;
    sh:closed false ;
    sh:property [
        sh:path sh:name;
        sh:minCount 0;
        sh:maxCount 1;
        sh:nodeKind sh:IRIOrLiteral
    ] .

notify:ArtifactShape
    a sh:NodeShape ;
    sh:closed false ;
    sh:property [
        sh:path ietf:cite-as;
        sh:minCount 0;
        sh:maxCount 1;
        sh:nodeKind sh:IRI
    ] ;
    sh:property [
        sh:path ietf:item;
        sh:minCount 1;
        sh:maxCount 1;
        sh:nodeKind sh:IRI;
        sh:node notify:ActivityStreamsTypes ;
        sh:node notify:ItemShape;
        sh:message "less than 1 value (not a valid ietf:item)"
    ].

notify:ContextShape
    a sh:NodeShape ;
    sh:closed false ;
    sh:property [
        sh:path ietf:cite-as;
        sh:minCount 0;
        sh:maxCount 1;
        sh:nodeKind sh:IRI
    ] ;
    sh:property [
        sh:path ietf:item;
        sh:minCount 0;
        sh:maxCount 1;
        sh:nodeKind sh:IRI;
        sh:node notify:ActivityStreamsTypes ;
        sh:node notify:ItemShape ;
        sh:message "less than 1 value (not a valid ietf:item)"
    ].

notify:ServiceResultShape
    a sh:NodeShape ;
    sh:closed false ;
    sh:property [
        sh:path ietf:cite-as;
        sh:minCount 0;
        sh:maxCount 1;
        sh:nodeKind sh:IRI
    ].

notify:RelationshipServiceResultShape
    a sh:NodeShape ;
    sh:closed false ;
    sh:property [
        sh:path as:subject ; 
        sh:minCount 1;
        sh:maxCount 1;
        sh:nodeKind sh:IRI
    ] ;
    sh:property [
        sh:path as:relationship ; 
        sh:minCount 1;
        sh:maxCount 1;
        sh:nodeKind sh:IRI
    ] ;
    sh:property [
        sh:path as:object ; 
        sh:minCount 1;
        sh:maxCount 1;
        sh:nodeKind sh:IRI
    ].

notify:ItemShape
    a sh:NodeShape ;
    sh:closed false ;
    # Ignore the SHOULD include a value from schema.org (optional)
    sh:property [
        sh:path as:mediaType;
        sh:minCount 1;
        sh:maxCount 1; 
        sh:shape sh:Literal
    ].

notify:OriginShape
    a sh:NodeShape ;
    sh:closed false ;
    # Ignoring the SHOULD as:Service value for class (optional)
    sh:property [
        sh:path ldp:inbox ;
        sh:minCount 1;
        sh:maxCount 1;
        sh:nodeKind sh:IRIOrLiteral ;
    ] .

notify:TargetShape
    a sh:NodeShape ;
    sh:closed false ;
    # Ignoring the SHOULD as:Service value for class (optional)
    sh:property [
        sh:path ldp:inbox ;
        sh:minCount 1;
        sh:maxCount 1;
        sh:nodeKind sh:IRIOrLiteral ;
    ] .

notify:ActivityStreamsGroupTypes
    a sh:NodeShape ;
    sh:message "A type that is not a valid ActivityStreams 2.0 type" ;
    sh:or (
            [ sh:class as:Application ]
            [ sh:class as:Group ]
            [ sh:class as:Organization ]
            [ sh:class as:Person ]
            [ sh:class as:Service ]
    ) .
 
notify:ActivityStreamsTypes
    a sh:NodeShape ;
    sh:message "A type that is not a valid ActivityStreams 2.0 type" ;
    sh:or (
        [ sh:class as:Activity ]
        [ sh:class as:Application ]
        [ sh:class as:Article ]
        [ sh:class as:Audio ]
        [ sh:class as:Collection ]
        [ sh:class as:CollectionPage ]
        [ sh:class as:Relationship ]
        [ sh:class as:Document ]
        [ sh:class as:Event ]
        [ sh:class as:Group ]
        [ sh:class as:Image ]
        [ sh:class as:IntransitiveActivity ]
        [ sh:class as:Note ]
        [ sh:class as:Object ]
        [ sh:class as:OrderedCollection ]
        [ sh:class as:OrderedCollectionPage ]
        [ sh:class as:Organization ]
        [ sh:class as:Page ]
        [ sh:class as:Person ]
        [ sh:class as:Place ]
        [ sh:class as:Profile ]
        [ sh:class as:Question ]
        [ sh:class as:Service ]
        [ sh:class as:Tombstone ]
        [ sh:class as:Video ]
    ) .